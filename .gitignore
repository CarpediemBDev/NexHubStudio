# --- Node / package managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# (보통 lock 파일은 커밋합니다. 필요 시 주석 해제)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# --- Build outputs ---
dist/
build/
.out/
.temp/
.tmp/

# --- Vite / tooling caches ---
.vite/
.eslintcache
.stylelintcache

# --- Env files (예시는 유지) ---
.env
.env.*
!.env.example

# --- Tests / coverage / reports ---
coverage/
.nyc_output/
reports/
junit.xml
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/
